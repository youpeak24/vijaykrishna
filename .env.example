# AI chat assistant (see api/chat.ts)
# SERVER-ONLY secret from https://console.groq.com/keys. Never prefix it with VITE_.
# Locally the Vite dev server (npm run dev) reads it from .env; on Vercel add it under
# Project Settings > Environment Variables, then redeploy.
GROQ_API_KEY=
# Optional: override the primary model (default openai/gpt-oss-120b, with automatic fallbacks).
GROQ_MODEL=
