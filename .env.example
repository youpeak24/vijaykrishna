# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env for local work. On Vercel add the same keys under
# Project Settings > Environment Variables, then redeploy.
#
# VITE_* values are PUBLIC (baked into the browser bundle). Never put secrets in them.
# Every VITE_* key has a built-in default, so leaving it blank or deleting it is safe.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site / SEO ───────────────────────────────────────────────────────────────
# Canonical production origin: used for canonical URLs, Open Graph, JSON-LD and sitemap.xml.
# No trailing slash. Use the final domain, not the *.vercel.app preview URL.
VITE_SITE_URL=https://vijaykrishnan.in

# Search-console ownership tokens (only the content="..." value, not the whole tag).
# Google: Search Console > Settings > Ownership verification > HTML tag
VITE_GOOGLE_SITE_VERIFICATION=
# Bing: Webmaster Tools > Verify ownership > HTML meta tag (msvalidate.01)
VITE_BING_SITE_VERIFICATION=

# ── Contact (shown on the site and in the footer) ────────────────────────────
VITE_CONTACT_EMAIL=contact@vijaykrishnan.in
VITE_CONTACT_PHONE=+91 98400 00000

# ── Social profiles (footer, contact page, and schema.org "sameAs") ──────────
# Make sure these point to real, existing profiles.
VITE_SOCIAL_INSTAGRAM=https://instagram.com/vijaykrishnan
VITE_SOCIAL_YOUTUBE=https://youtube.com/@vijaykrishnan
VITE_SOCIAL_IMDB=https://imdb.com/name/vijaykrishnan
VITE_SOCIAL_LINKEDIN=https://linkedin.com/in/vijaykrishnan

# ── AI chat assistant (see api/chat.ts) ──────────────────────────────────────
# SERVER-ONLY secret from https://console.groq.com/keys. Never prefix it with VITE_.
# Locally the Vite dev server (npm run dev) reads it from .env.
GROQ_API_KEY=
# Optional: override the primary model (default openai/gpt-oss-120b, with automatic fallbacks).
GROQ_MODEL=
